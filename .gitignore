# Terraform state files - contain sensitive data, never commit
**/*.tfstate
**/*.tfstate.*
**/*.tfstate.backup

# Terraform working directory
**/.terraform/
**/.terraform.lock.hcl

# Variable files that may contain secrets
**/*.tfvars
**/*.tfvars.json

# Crash logs
**/crash.log
**/crash.*.log

# Override files
**/override.tf
**/override.tf.json
**/*_override.tf

# SSH keys - never commit private keys
*.pem
id_rsa
id_rsa.pub
terraform-ec2-key
terraform-ec2-key.pub